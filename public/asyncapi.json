    "schemas": {
      "ConversationId": {
        "type": "string",
        "format": "uuid",
        "description": "Internal UUIDv7 conversation identifier."
      },
      "EventId": {
        "type": "string",
        "format": "uuid",
        "description": "Globally unique UUIDv7 event identifier used for deduplication."
      },
      "MessageId": {
        "type": "string",
        "format": "uuid",
        "description": "Internal UUIDv7 conversation-message identifier."
      },
      "Topic": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "externalId"],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "externalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        }
      },
      "NullableTopic": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Topic"
          },
          {
            "type": "null"
          }
        ]
      },
      "ConversationState": {
        "type": "string",
        "enum": [
          "awaiting_us",
          "awaiting_participant",
          "concluded",
          "terminated"
        ]
      },
      "StateTransition": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ConversationState"
              },
              {
                "type": "null"
              }
            ]
          },
          "to": {
            "$ref": "#/components/schemas/ConversationState"
          }
        }
      },
      "DeliveryState": {
        "type": "string",
        "enum": [
          "delivered",
          "delivery_delayed",
          "bounced",
          "complained",
          "suppressed",
          "failed"
        ]
      },
      "ConversationEventHeaders": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "x-conversation-event-id",
          "x-conversation-event-schema-version"
