{
  "asyncapi": "3.1.0",
  "id": "urn:resend-conversation-service:conversation-events",
  "info": {
    "title": "resend-conversation-service Conversation Events API",
    "version": "0.7.0-rc.6",
    "description": "Versioned, non-sensitive conversation lifecycle events published to NATS JetStream. Transport-specific metadata is described on the channel."
  },
  "defaultContentType": "application/json",
  "servers": {
    "nats": {
      "host": "{server}",
      "protocol": "nats",
      "description": "A NATS server from CONVERSATION_EVENTS_NATS_SERVERS. Subscriber endpoints and credentials are deployment-owned.",
      "variables": {
        "server": {
          "default": "nats:4222",
          "description": "Deployment-provided NATS host and port. The default is an AsyncAPI substitution example, not a service runtime fallback."
        }
      }
    }
  },
  "channels": {
    "natsConversationEvents": {
      "address": "{subject}",
      "title": "NATS conversation events",
      "description": "The configured NATS JetStream subject. JetStream also sets the protocol-defined Nats-Msg-Id to the payload event id for publish deduplication.",
      "servers": [
        {
          "$ref": "#/servers/nats"
        }
      ],
      "parameters": {
        "subject": {
          "default": "conversation.events.v1",
          "description": "The deployment-provided value of CONVERSATION_EVENTS_NATS_SUBJECT. The default is an AsyncAPI substitution example; runtime configuration is required when the sink is enabled."
        }
      },
      "messages": {
        "conversationCreated": {
          "$ref": "#/components/messages/conversationCreated"
        },
        "conversationMessageReceived": {
          "$ref": "#/components/messages/conversationMessageReceived"
        },
        "conversationMessageOutboundIntended": {
          "$ref": "#/components/messages/conversationMessageOutboundIntended"
        },
        "conversationStateChanged": {
          "$ref": "#/components/messages/conversationStateChanged"
        },
        "conversationAssigned": {
          "$ref": "#/components/messages/conversationAssigned"
        },
        "conversationMessageDeliveryUpdated": {
          "$ref": "#/components/messages/conversationMessageDeliveryUpdated"
        },
        "conversationMerged": {
          "$ref": "#/components/messages/conversationMerged"
        }
      }
    }
  },
  "operations": {
    "publishConversationEventsToNats": {
      "action": "send",
      "title": "Publish conversation events to NATS",
      "summary": "Publishes committed conversation lifecycle events to the configured JetStream subject.",
      "description": "Delivery is at least once and persisted through a durable per-sink delivery record. Failed publication is retried without a terminal attempt limit and blocks later sequence values for the same conversation. Deduplicate by payload id, process each conversation by sequence, and do not assume sequence 1 will be available. Enabling this sink does not backfill events committed before it became active.",
      "channel": {
        "$ref": "#/channels/natsConversationEvents"
      },
      "messages": [
        {
          "$ref": "#/channels/natsConversationEvents/messages/conversationCreated"
        },
        {
          "$ref": "#/channels/natsConversationEvents/messages/conversationMessageReceived"
        },
        {
          "$ref": "#/channels/natsConversationEvents/messages/conversationMessageOutboundIntended"
        },
        {
          "$ref": "#/channels/natsConversationEvents/messages/conversationStateChanged"
        },
        {
          "$ref": "#/channels/natsConversationEvents/messages/conversationAssigned"
        },
        {
          "$ref": "#/channels/natsConversationEvents/messages/conversationMessageDeliveryUpdated"
        },
        {
          "$ref": "#/channels/natsConversationEvents/messages/conversationMerged"
        }
      ],
      "bindings": {
        "nats": {
          "bindingVersion": "0.1.0"
        }
      }
    }
  },
  "components": {
    "messages": {
      "conversationCreated": {
        "name": "conversation.created",
        "title": "Conversation created",
        "summary": "A conversation was created from outbound intent or inbound email.",
        "payload": {
          "$ref": "#/components/schemas/ConversationCreatedEvent"
        },
        "traits": [
          {
            "$ref": "#/components/messageTraits/conversationEvent"
          }
        ],
        "examples": [
          {
            "name": "outboundConversationCreated",
