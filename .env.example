# Set this to the connection URL exposed by Railway Postgres
DATABASE_URL=postgresql://user:password@host:5432/database

# Integration tests truncate tables. This optional override defaults to the
# local disposable database defined by docker-compose.yml.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resend_test

# Shared Resend credential used to retrieve inbound and send outbound email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# Optional Resend-compatible endpoint used by integration tests
RESEND_API_BASE_URL=

# Get this from the Resend Dashboard when creating the webhook
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# Base mailbox on a Resend Receiving domain; conversation tags are appended
RESEND_REPLY_TO=mailbox@replies.example.com

# Long random bearer credential for the email and conversation API
# EMAIL_V2_API_KEY is accepted as a fallback; this spelling takes precedence.
EMAIL_v2_API_KEY=replace-with-a-different-long-random-secret

# Separate bearer credential used by the outbox drain caller
OUTBOX_DRAIN_API_KEY=replace-with-another-long-random-secret

# Optional built-in cron scheduler for the outbox drain. Disabled unless
# OUTBOX_DRAIN_SCHEDULE_ENABLED is exactly "true"; an external caller of
# POST /api/emails/v2/outbox/drain remains fully supported and unaffected.
# OUTBOX_DRAIN_SCHEDULE_ENABLED=true
# OUTBOX_DRAIN_SCHEDULE=*/5 * * * *   # required when enabled; 5 or 6 cron fields
# OUTBOX_DRAIN_SCHEDULE_TIMEZONE=UTC  # IANA name
# OUTBOX_DRAIN_SCHEDULE_BATCH_SIZE=100 # messages per batch, 1-100
# OUTBOX_DRAIN_SCHEDULE_MAX_BATCHES=5  # batches per tick, 1-100

# Optional durable conversation-event sink. Leave unset to disable the worker.
# The stream must already exist; provision it with
# nats stream add --config infra/nats/streams/CONVERSATION_EVENTS.json
# CONVERSATION_EVENTS_SINKS=nats
# CONVERSATION_EVENTS_NATS_SERVERS=nats://nats:4222
# CONVERSATION_EVENTS_NATS_STREAM=CONVERSATION_EVENTS
# CONVERSATION_EVENTS_NATS_SUBJECT=conversation.events.v1
# CONVERSATION_EVENTS_NATS_TLS_MODE=disabled # disabled, system, or custom
# CONVERSATION_EVENTS_NATS_TOKEN=
# CONVERSATION_EVENTS_NATS_USERNAME=
# CONVERSATION_EVENTS_NATS_PASSWORD=
