  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "expr": "sum(rate(http_server_request_count_total{service_name=~\"$service_name\",deployment_environment_name=~\"$environment\",service_group=~\"$service_group\",vcs_revision=~\"$revision\"}[5m]))",
          "refId": "A"
        }
      ],
      "title": "HTTP request rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket{service_name=~\"$service_name\",deployment_environment_name=~\"$environment\",service_group=~\"$service_group\",vcs_revision=~\"$revision\"}[5m])) by (le))",
          "refId": "A"
        }
      ],
      "title": "HTTP p95 duration",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "targets": [
        {
          "expr": "resend_conversation_outbox_pending{service_name=~\"$service_name\",deployment_environment_name=~\"$environment\",service_group=~\"$service_group\",vcs_revision=~\"$revision\"}",
          "refId": "A"
        }
      ],
      "title": "Pending outbox messages",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "targets": [
        {
          "expr": "resend_conversation_outbox_oldest_pending_age_seconds{service_name=~\"$service_name\",deployment_environment_name=~\"$environment\",service_group=~\"$service_group\",vcs_revision=~\"$revision\"}",
          "refId": "A"
        }
      ],
      "title": "Oldest pending outbox message",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "id": 5,
      "targets": [
        {
          "expr": "{service_name=~\"$service_name\", deployment_environment_name=~\"$environment\", service_group=~\"$service_group\", vcs_revision=~\"$revision\"}",
          "refId": "A"
        }
      ],
      "title": "Application logs",
      "type": "logs"
    }
  ],
